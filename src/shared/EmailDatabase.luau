function EmailDatabase.getAll()
	return EMAILS
end

function EmailDatabase.getByTier(tier: number)
	local result = {}
	for _, item in EMAILS do
		if item.tier == tier then
			table.insert(result, item)
		end
	end
	return result
end

function EmailDatabase.getShiftScenario(shift: number)
	for _, item in EMAILS do
		if item.shift == shift then
			return item
		end
	end
	return nil
end

function EmailDatabase.getRandomByTier(tier: number, isScam: boolean?)
	local pool = {}
	for _, item in EMAILS do
		if item.tier == tier and (isScam == nil or item.isScam == isScam) then
			table.insert(pool, item)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

return EmailDatabase
